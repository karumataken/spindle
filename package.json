{
  "name": "spindle-music-player",
  "productName": "Spindle",
  "version": "1.0.0",
  "description": "Tactile retro vinyl record player and music manager in the browser",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron --no-sandbox .",
    "dev:desktop": "vite build && electron --no-sandbox .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:win": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.spindle.musicplayer",
    "productName": "Spindle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spindle"
    }
  },
  "keywords": [],
  "author": "Spindle Team <contact@spindleplayer.app>",
  "license": "ISC",
  "dependencies": {
    "three": "^0.128.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  }
}
